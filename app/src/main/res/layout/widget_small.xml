<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="Progress" />

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="60%"
            android:textColor="#1D1B2E"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="3 tasks left"
        android:textColor="#1D1B2E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_habits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Habits 2/5"
        android:textColor="#5C6078"
        android:textSize="11sp" />
</LinearLayout>
